---
import ThemeSwitcher from "./ThemeSwitcher.astro";
const { title = "Suson.Codes" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body x-data="{theme: 'catppuccin'}">
    <div id="main-content" :data-webtui-theme="theme">
      <slot />
      <ThemeSwitcher />
    </div>
  </body>
</html>

<style is:global>
  @import "@/styles/global.css";
</style>

<style>
  #main-content {
    padding-inline: 4ch;
    background-color: var(--crust);
  }
</style>
